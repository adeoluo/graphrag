flowchart TD
    classDef edge     fill:#F59E0B,stroke:#1E293B,color:#1E293B,stroke-width:1px;
    classDef core     fill:#6366F1,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef data     fill:#10B981,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef control  fill:#0EA5E9,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef obs      fill:#CBD5E1,stroke:#1E293B,color:#1E293B,stroke-width:1px;

    User([CLI user]):::edge
    Client([HTTP client]):::edge

    subgraph Interfaces["Interfaces (CLI and stdlib HTTP)"]
        direction TB
        CLI["cli.py<br/>graph | ask | evaluate | serve"]:::edge
        Router["service.py router<br/>/health /ready /ask /metrics"]:::core
        Validate["Query validation<br/>max 2000 characters"]:::control
    end

    subgraph Core["Core logic (graph build and traversal)"]
        direction TB
        Extract["extraction.py<br/>entities and 6 relation types"]:::core
        Link["Entity linking<br/>exact, then containment"]:::core
        BFS["Breadth-first traversal<br/>max 3 hops, reachable subgraph"]:::core
        PathSel["Path selection<br/>target relation or country chain"]:::core
    end

    subgraph State["Data and state (in memory)"]
        direction TB
        Docs[("Document corpus<br/>data.py")]:::data
        Graph[("Knowledge graph<br/>labeled multigraph with provenance")]:::data
        Questions[("Question set<br/>single and multi-hop")]:::data
    end

    subgraph Obs["Evaluation and observability"]
        direction TB
        Answer["Answer JSON<br/>relation path as citation, confidence"]:::obs
        Eval["evaluation.py<br/>accuracy by hop count"]:::obs
        Flat["Flat baseline<br/>best keyword-overlap passage"]:::obs
        Metrics["ServiceMetrics<br/>Prometheus text"]:::obs
    end

    User -->|arguments| CLI
    Client -->|JSON request| Router
    Router -->|POST /ask| Validate
    Docs -->|sentences| Extract
    Extract -->|triples| Graph
    Validate -->|query| Link
    CLI -->|question| Link
    Graph -.->|entity names| Link
    Link -->|seed entities| BFS
    Graph -.->|neighbors| BFS
    BFS -->|subgraph| PathSel
    PathSel -->|answer and path| Answer
    Questions -.->|gold answers| Eval
    PathSel -->|graph answers| Eval
    Docs -.-> Flat
    Flat -->|flat answers| Eval
    Router -.->|route latency and errors| Metrics
