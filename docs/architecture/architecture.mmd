flowchart LR
    classDef edge     fill:#F59E0B,stroke:#1E293B,color:#1E293B,stroke-width:1px;
    classDef core     fill:#6366F1,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef data     fill:#10B981,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef control  fill:#0EA5E9,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef obs      fill:#CBD5E1,stroke:#1E293B,color:#1E293B,stroke-width:1px;

    subgraph Interfaces["Interfaces"]
        direction TB
        Users([Users and clients]):::edge
        CLI["CLI<br/>graph, ask, evaluate"]:::edge
        Router["HTTP service<br/>/ask /metrics"]:::core
        Validate["Validation<br/>query, max 2000 chars"]:::control
        Users --> CLI ~~~ Router --> Validate
    end

    subgraph State["Graph build and data"]
        direction TB
        Docs[("Document corpus")]:::data
        Extract["Extraction<br/>entities, 6 relations"]:::core
        Graph[("Knowledge graph<br/>with provenance")]:::data
        Questions[("Question set<br/>single and multi-hop")]:::data
        Docs --> Extract --> Graph ~~~ Questions
    end

    subgraph Core["Traversal retrieval"]
        direction TB
        Link["Entity linking<br/>exact, containment"]:::core
        BFS["BFS traversal<br/>up to 3 hops"]:::core
        Path["Path selection<br/>relation or country"]:::core
        Link --> BFS --> Path
    end

    subgraph Obs["Evaluation and observability"]
        direction TB
        Answer["Answer JSON<br/>path as citation"]:::obs
        Flat["Flat baseline<br/>keyword overlap"]:::obs
        Eval["Accuracy<br/>single vs multi-hop"]:::obs
        Metrics["Metrics<br/>Prometheus text"]:::obs
        Answer --> Eval
        Flat --> Eval
        Eval ~~~ Metrics
    end

    Interfaces -->|question| Core
    State -.->|entities, edges| Core
    Core -->|answer, path| Obs
    State -.->|gold answers| Obs
