---
title: System Architecture - GraphRAG
config:
  theme: base
  themeVariables:
    fontFamily: "Inter, system-ui, sans-serif"
    primaryColor: "#F8FAFC"
    primaryBorderColor: "#1E293B"
    primaryTextColor: "#1E293B"
    lineColor: "#64748B"
    clusterBkg: "#E2E8F0"
    clusterBorder: "#94A3B8"
---
flowchart LR
    classDef core     fill:#6366F1,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef data     fill:#10B981,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef external fill:#F59E0B,stroke:#1E293B,color:#1E293B,stroke-width:1px;

    Docs[(Documents)]:::data
    Question([Question]):::external

    subgraph Build["Graph Construction"]
        Extract[Entity + relation extraction]:::core
        Graph[(Knowledge graph)]:::data
    end

    subgraph Retrieve["Traversal Retrieval"]
        Link[Entity linking]:::core
        Traverse[BFS traversal]:::core
        Answer[Path-based answer]:::core
    end

    Docs --> Extract
    Extract -->|triples| Graph
    Question --> Link
    Link -->|seed entities| Traverse
    Graph --> Traverse
    Traverse --> Answer
    Answer -->|cited path| Question
